<div class="card">
   <div class="card-body">
      {% if description is null %}
         <p class="text-muted mb-0">{{ __('This document has not been queued for analysis.', 'documentaliste') }}</p>
      {% else %}
         {% set status = description.fields['status'] %}
         <dl class="row mb-0">
            <dt class="col-sm-3">{{ __('Analysis status', 'documentaliste') }}</dt>
            <dd class="col-sm-9">
               <span class="badge {{ status == 'done' ? 'bg-green-lt' : (status == 'error' ? 'bg-red-lt' : 'bg-secondary-lt') }}">{{ status }}</span>
            </dd>

            {% if description.fields['summary'] is not empty %}
               <dt class="col-sm-3">{{ __('Synthetic description', 'documentaliste') }}</dt>
               <dd class="col-sm-9">{{ description.fields['summary'] }}</dd>
            {% endif %}

            {% if keywords is not empty %}
               <dt class="col-sm-3">{{ __('Keywords', 'documentaliste') }}</dt>
               <dd class="col-sm-9">
                  {% for keyword in keywords %}
                     <span class="badge bg-blue-lt me-1">{{ keyword }}</span>
                  {% endfor %}
               </dd>
            {% endif %}

            {% if detected_types is not empty %}
               <dt class="col-sm-3">{{ __('Detected sensitive content', 'documentaliste') }}</dt>
               <dd class="col-sm-9">
                  {% for type in detected_types %}
                     <span class="badge bg-orange-lt me-1"><i class="ti ti-alert-triangle"></i> {{ type }}</span>
                  {% endfor %}
               </dd>
            {% endif %}

            {% if description.fields['error_message'] is not empty %}
               <dt class="col-sm-3">{{ __('Last error', 'documentaliste') }}</dt>
               <dd class="col-sm-9 text-danger">{{ description.fields['error_message'] }}</dd>
            {% endif %}

            {% if description.fields['date_analyzed'] is not empty %}
               <dt class="col-sm-3">{{ __('Analyzed on', 'documentaliste') }}</dt>
               <dd class="col-sm-9">{{ description.fields['date_analyzed']|formatted_datetime }}
                  <span class="text-muted">({{ description.fields['describer'] }}{{ description.fields['model'] ? ' / ' ~ description.fields['model'] : '' }})</span>
               </dd>
            {% endif %}
         </dl>
      {% endif %}
   </div>
</div>
